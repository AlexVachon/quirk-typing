// `typing.prelude` — one-stop re-export module for the pieces every
// stdlib type file drags in. Instead of the 5–8 import lines each
// `packages/typing/**/*.quirk` needs today:
//
//   from typing.primitives.string use { String }
//   from typing.collections.list  use { List }
//   from typing.collections.map   use { Map }
//   from typing.interfaces.primitive use { Primitive }
//   from typing.interfaces.comparable use { Comparable }
//   …
//
// a builtin type file (or user code) can now write:
//
//   from typing.prelude use { String, List, Map, Primitive, Comparable, ... }
//
// Same names, one line. Only the imports you actually reference need
// listing — `use *` isn't supported. The prelude covers everything
// stdlib type files typically need; user code should prefer
// `from typing use { ... }` (top-level typing index) which is broader.

from .primitives use {
    Int, Double, Bool,
    String, StringIterator
}

// Collections landed in prelude at v1.15.1 — the initial v1.15.0
// shipped without them, which meant `from typing.prelude use { Map,
// List }` (a very natural import in user code) errored in the LSP
// export-check and forced users to import from the per-module paths.
from .collections use {
    List, ListIterator,
    Map, MapIterator, MapPairIterator,
    Set, SetIterator,
    Queue, QueueIterator,
    Tuple, TupleIterator
}

from .interfaces use {
    Printable,
    Equatable,
    Comparable,
    Hashable,
    Parseable,
    Sizeable,
    Iterable,
    Iterator,
    Representable,
    Primitive,
    ISerializable
}

from .callable use { Callable }
